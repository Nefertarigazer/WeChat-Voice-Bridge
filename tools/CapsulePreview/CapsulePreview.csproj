<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders the real ModeCapsule (linked from the app) in each state to PNG,
       so its look can be checked without opening the app or touching user data. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\VoiceBridge.App\ModeCapsule.cs" Link="ModeCapsule.cs" />
    <Compile Include="..\..\src\VoiceBridge.App\ModeCard.cs" Link="ModeCard.cs" />
  </ItemGroup>
</Project>
