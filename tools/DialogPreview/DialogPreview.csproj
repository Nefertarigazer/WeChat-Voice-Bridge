<Project Sdk="Microsoft.NET.Sdk">
  <!-- Opens the app's real 更新说明 and 隐私/提醒 settings cards off screen and saves PNGs,
       checking the half-line cut, the scrollbar fade and 试听/取消, without starting the
       app or touching user data. Build it in Debug: Release would write into the app's
       own bin\Release folder, which a running copy of the app keeps locked. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\VoiceBridge.App\VoiceBridge.App.csproj" />
  </ItemGroup>
</Project>
