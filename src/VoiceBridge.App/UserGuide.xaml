<UserControl x:Class="VoiceBridge.App.UserGuide"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI" FontSize="14"
             TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <UserControl.Resources>
    <Style x:Key="GuideParagraph" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="25"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#52615A"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
    <DataTemplate x:Key="GuideSectionHeader">
      <StackPanel>
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" Foreground="#244C3C"/>
        <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" LineHeight="20" Margin="0,6,0,0"/>
      </StackPanel>
    </DataTemplate>
    <Style x:Key="GuideExpander" TargetType="Expander">
      <Setter Property="Margin" Value="0,0,0,12"/>
      <Setter Property="Background" Value="{StaticResource CardBg}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource Separator}"
                    BorderThickness="1" CornerRadius="14">
              <StackPanel>
                <ToggleButton x:Name="HeaderToggle" Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                              HorizontalContentAlignment="Stretch" Cursor="Hand">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border x:Name="HeaderSurface" Background="Transparent" Padding="20,18" CornerRadius="13">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="24"/>
                          </Grid.ColumnDefinitions>
                          <ContentPresenter Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            VerticalAlignment="Center" Margin="0,0,10,0"/>
                          <Path x:Name="Chevron" Grid.Column="1" Data="M 1,1 L 6,6 L 1,11" Width="6" Height="10"
                                Stroke="{StaticResource Secondary}" StrokeThickness="1.5" Stretch="Uniform"
                                VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
                          </Path>
                        </Grid>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="HeaderSurface" Property="Background" Value="{StaticResource Fill}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                          <Setter TargetName="HeaderSurface" Property="Background" Value="{StaticResource AccentSoft}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                          <Setter TargetName="Chevron" Property="RenderTransform">
                            <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                          </Setter>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter x:Name="Body" ContentSource="Content" Margin="20,0,20,16"
                                  Visibility="Collapsed"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <StackPanel Margin="0,0,0,48">
    <TextBlock Text="使用说明" Style="{StaticResource Title}"/>
    <TextBlock Text="从第一次配置，到日常使用。按需要展开，随时回来查阅。" Style="{StaticResource Subtitle}" Margin="0,8,0,22"/>

    <Border Background="{StaticResource AccentSoft}" BorderBrush="#CEE6D8" BorderThickness="1"
            CornerRadius="18" Padding="22,20">
      <StackPanel>
        <TextBlock Text="快速开始" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
        <TextBlock Text="让文字，变成熟悉的声音" FontSize="21" FontWeight="SemiBold" Margin="0,6,0,18"/>
        <UniformGrid Columns="3">
          <Border Background="#F9FCFA" CornerRadius="12" Padding="13" Margin="0,0,8,0"><StackPanel>
            <TextBlock Text="01" Foreground="{StaticResource Accent}" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="连接服务" FontWeight="SemiBold" Margin="0,8,0,5"/>
            <TextBlock Text="登录电脑微信，在「设置」添加语音服务。" Style="{StaticResource GuideParagraph}"/>
          </StackPanel></Border>
          <Border Background="#F9FCFA" CornerRadius="12" Padding="13" Margin="0,0,8,0"><StackPanel>
            <TextBlock Text="02" Foreground="{StaticResource Accent}" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="添加音色" FontWeight="SemiBold" Margin="0,8,0,5"/>
            <TextBlock Text="填写音色名称和标识，先试听一句。" Style="{StaticResource GuideParagraph}"/>
          </StackPanel></Border>
          <Border Background="#F9FCFA" CornerRadius="12" Padding="13"><StackPanel>
            <TextBlock Text="03" Foreground="{StaticResource Accent}" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="选择联系人" FontWeight="SemiBold" Margin="0,8,0,5"/>
            <TextBlock Text="分配音色与提示词，点击开始监听。" Style="{StaticResource GuideParagraph}"/>
          </StackPanel></Border>
        </UniformGrid>
        <TextBlock Text="等到「正在监听」再发送测试消息。随时点「结束」，即可停止朗读。" FontSize="12" Foreground="#456555" LineHeight="21" Margin="0,15,0,0"/>
      </StackPanel>
    </Border>

    <TextBlock Text="按需查阅" FontSize="12" Foreground="{StaticResource Secondary}" FontWeight="SemiBold" Margin="2,24,0,10"/>
    <WrapPanel Margin="0,0,0,16">
      <WrapPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="12,6"/></Style></WrapPanel.Resources>
      <Button Content="第一次配置" Tag="setup" Click="JumpClick" Margin="0,0,8,6"/>
      <Button Content="接入语音服务" Tag="vendors" Click="JumpClick" Margin="0,0,8,6"/>
      <Button Content="多人和提示词" Tag="many" Click="JumpClick" Margin="0,0,8,6"/>
      <Button Content="遇到问题" Tag="troubleshooting" Click="JumpClick" Margin="0,0,8,6"/>
      <Button Content="更新日志" Tag="history" Click="JumpClick" Margin="0,0,0,6"/>
    </WrapPanel>

    <ItemsControl x:Name="Sections">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Expander Style="{StaticResource GuideExpander}" Header="{Binding}"
                    HeaderTemplate="{StaticResource GuideSectionHeader}" IsExpanded="{Binding Expanded, Mode=OneWay}"
                    AutomationProperties.Name="{Binding Title}">
            <ItemsControl ItemsSource="{Binding Paragraphs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate><Border Background="#F7F9F8" CornerRadius="9" Padding="14,11" Margin="0,0,0,8"><TextBlock Text="{Binding}" Style="{StaticResource GuideParagraph}"/></Border></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock x:Name="HistoryHeading" Text="更新日志" Style="{StaticResource SectionTitle}" Margin="2,22,0,8"/>
    <TextBlock Text="更新说明会保留在这里。点开版本可查看当时的改动，升级时显示的说明也来自同一份记录。"
               Style="{StaticResource Subtitle}" Margin="2,0,0,16"/>
    <ItemsControl x:Name="ReleaseList">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Expander Style="{StaticResource GuideExpander}" Header="{Binding Heading}"
                    AutomationProperties.Name="{Binding Heading}">
            <ItemsControl ItemsSource="{Binding Changes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="•" Foreground="{StaticResource Accent}"/>
                    <TextBlock Grid.Column="1" Text="{Binding}" LineHeight="24" TextWrapping="Wrap"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
