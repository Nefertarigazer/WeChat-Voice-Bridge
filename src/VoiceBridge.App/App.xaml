<Application x:Class="VoiceBridge.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VoiceBridge.App" ShutdownMode="OnMainWindowClose">
  <Application.Resources>

    <!-- ============ 色板：中性底色 + 与图标一致的薄荷绿 ============ -->
    <Color x:Key="PageBgColor">#F6F8F7</Color>
    <Color x:Key="PageBgClearColor">#00F6F8F7</Color>
    <SolidColorBrush x:Key="PageBg" Color="{StaticResource PageBgColor}"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#EDF2F0"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Fill" Color="#F0F4F2"/>
    <SolidColorBrush x:Key="FillStrong" Color="#E3E9E6"/>
    <SolidColorBrush x:Key="Label" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="Secondary" Color="#6E7673"/>
    <SolidColorBrush x:Key="Tertiary" Color="#A8B0AC"/>
    <SolidColorBrush x:Key="Accent" Color="#0B8F66"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#E3F5EC"/>
    <SolidColorBrush x:Key="Separator" Color="#E6EBE9"/>
    <SolidColorBrush x:Key="Positive" Color="#1D9A5B"/>
    <SolidColorBrush x:Key="Caution" Color="#B2760A"/>
    <SolidColorBrush x:Key="Danger" Color="#D33B3B"/>
    <!-- Three update states, three distinct colours, one shared geometry. -->
    <SolidColorBrush x:Key="UpdateReadyText" Color="#0E7351"/>
    <SolidColorBrush x:Key="UpdateReadyFill" Color="#E9F6EF"/>
    <SolidColorBrush x:Key="UpdateReadyBorder" Color="#9CCBB4"/>
    <SolidColorBrush x:Key="UpdateInstallFill" Color="#0B8F66"/>
    <SolidColorBrush x:Key="UpdateInstallBorder" Color="#0A7C59"/>
    <SolidColorBrush x:Key="WhiteText" Color="#FFFFFF"/>

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <local:InverseBoolToVis x:Key="InverseBoolToVis"/>

    <Style x:Key="DialogCloseButton" TargetType="Button">
      <Setter Property="Width" Value="42"/><Setter Property="Height" Value="30"/>
      <Setter Property="Margin" Value="4,3,4,3"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Root" Background="Transparent" CornerRadius="6">
          <Path x:Name="Glyph" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                Data="M 1,1 L 9,9 M 9,1 L 1,9" Stroke="{StaticResource Secondary}" StrokeThickness="1"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#C42B1C"/><Setter TargetName="Glyph" Property="Stroke" Value="White"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="#A81E13"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <DataTemplate x:Key="DeviceNameTemplate">
      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
    </DataTemplate>

    <!-- ============ 文字 ============ -->
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Label}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="Title" TargetType="TextBlock">
      <Setter Property="FontSize" Value="30"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Label}"/>
    </Style>
    <Style x:Key="Subtitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Label}"/>
    </Style>
    <!-- 分组上方的小标题 -->
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
      <Setter Property="Margin" Value="14,24,0,8"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
    <!-- 分组下方的说明 -->
    <Style x:Key="Footnote" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
      <Setter Property="Margin" Value="14,8,14,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- 一行设置左边的名称 -->
    <Style x:Key="RowLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{StaticResource Label}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
    <!-- 对话框里放在输入框上方的标签 -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- 昵称里的生僻符号靠 Segoe UI Symbol 兜底，请保留 -->
    <Style x:Key="ContactName" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Symbol, Microsoft YaHei UI"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ============ 容器 ============ -->
    <!-- 状态大卡片 -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBg}"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="24,20"/>
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="24" ShadowDepth="2" Direction="270" Opacity="0.06" Color="#2B3A35"/>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- 分组：白色圆角，行与行之间用细线隔开 -->
    <Style x:Key="Group" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBg}"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="BorderBrush" Value="#E9EEEC"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="Row" TargetType="Border">
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="MinHeight" Value="52"/>
    </Style>
    <Style x:Key="Hairline" TargetType="Border">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Margin" Value="16,0,0,0"/>
      <Setter Property="Background" Value="{StaticResource Separator}"/>
    </Style>

    <!-- ============ 按钮：悬停时盖一层半透明，按下更深 ============ -->
    <Style TargetType="Button">
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="9"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                  <ContentPresenter.Resources>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                      <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Style>
                  </ContentPresenter.Resources>
                </ContentPresenter>
              </Border>
              <Border x:Name="Veil" CornerRadius="9" Background="#12000000" Opacity="0" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Veil" Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Veil" Property="Background" Value="#26000000"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Veil" Property="Opacity" Value="0"/>
                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="24,8"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="MinWidth" Value="96"/>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Fill}"/>
      <Setter Property="Foreground" Value="{StaticResource Label}"/>
      <Setter Property="Padding" Value="16,7"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>
    <!-- Available update. Shares the row's 36 DIP height with SecondaryButton, so
         switching state changes colour only, never the layout or the baseline. -->
    <Style x:Key="UpdateReadyButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource UpdateReadyText}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="20,0"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="MinWidth" Value="132"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Frame" CornerRadius="9" Padding="{TemplateBinding Padding}"
                  Background="{StaticResource UpdateReadyFill}"
                  BorderBrush="{StaticResource UpdateReadyBorder}" BorderThickness="1">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
              <ContentPresenter.Resources>
                <!-- The global implicit TextBlock style paints dark text; bind the
                     generated label back to the button so the solid green "install"
                     state keeps its white ink. -->
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Frame" Property="Background" Value="#D8EDE1"/>
              <Setter TargetName="Frame" Property="BorderBrush" Value="#7EB99C"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Frame" Property="Background" Value="#C6E2D2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Frame" Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <!-- Verified package: the strongest of the three, but exactly the same size. -->
    <Style x:Key="UpdateInstallButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="20,0"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="MinWidth" Value="132"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Frame" CornerRadius="9" Padding="{TemplateBinding Padding}"
                  Background="{StaticResource UpdateInstallFill}"
                  BorderBrush="{StaticResource UpdateInstallBorder}" BorderThickness="1">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
              <ContentPresenter.Resources>
                <!-- The global implicit TextBlock style paints dark text; bind the
                     generated label back to the button so the solid green "install"
                     state keeps its white ink. -->
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Frame" Property="Background" Value="#097A57"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Frame" Property="Background" Value="#076B4C"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Frame" Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <!-- One action per service row: a white "启用" normally, solid green "使用中"
         when that key is the one in use. The row's dot repeats the same state. -->
    <Style x:Key="ProviderEnableButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#2E3A33"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#D6DFD9"/>
      <Setter Property="Content" Value="启用"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="14,5"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="MinWidth" Value="64"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Frame" CornerRadius="8" Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  </Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Border>
            <!-- Hover presses a veil over the frame instead of repainting the
                 background, so the green "in use" state keeps its colour. -->
            <Border x:Name="Veil" CornerRadius="8" Background="#12000000" Opacity="0" IsHitTestVisible="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Veil" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Veil" Property="Background" Value="#26000000"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsActive}" Value="True">
          <Setter Property="Background" Value="#1D9A5B"/>
          <Setter Property="BorderBrush" Value="#1D9A5B"/>
          <Setter Property="Foreground" Value="White"/>
          <Setter Property="Content" Value="使用中"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- ============ 「⋮」溢出菜单 ============ -->
    <!-- WPF 的默认菜单是灰渐变边 + 方角 + 紧凑行高，和卡片画风完全不同。
         这里换成白底圆角小面板：外面留出阴影的空隙（那圈是透明的），
         里面一层细边框 + 4px 内边距，菜单项自己负责悬停底色。 -->
    <Style x:Key="RowMenu" TargetType="ContextMenu">
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <!-- The panel opens to the right of the ⋮ button. Width is tuned so the panel
           reads as roughly square rather than a tall sliver (two 34px rows), while its
           right edge still keeps a margin from the window border. -->
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Width" Value="112"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Padding="10" Background="Transparent">
              <Border CornerRadius="12" Padding="4"
                      Background="{StaticResource CardBg}"
                      BorderBrush="#E9EEEC" BorderThickness="1">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.16" Color="#2B3A35"/>
                </Border.Effect>
                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
              </Border>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- 菜单里的一行：文字左对齐留足边距，悬停时铺一层底色（底色由 Background
         承载，删除项因此能用自己的淡红），删除项文字用警示红。 -->
    <Style x:Key="RowMenuItem" TargetType="MenuItem">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#2E3A33"/>
      <Setter Property="Background" Value="{StaticResource Fill}"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="Hit" CornerRadius="7" Background="Transparent"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center">
                  <ContentPresenter.Resources>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}"/>
                    </Style>
                  </ContentPresenter.Resources>
                </ContentPresenter>
                <!-- The text box's cut/copy/paste menu carries a shortcut hint; the app's
                     own menus leave this empty and the column collapses, so both kinds
                     share one template without looking different. -->
                <TextBlock x:Name="Gesture" Grid.Column="1" Text="{TemplateBinding InputGestureText}"
                           Margin="18,0,0,0" FontSize="11" Opacity="0.55" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Hit" Property="Background"
                        Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
              <Trigger Property="InputGestureText" Value="">
                <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RowMenuItemDanger" TargetType="MenuItem" BasedOn="{StaticResource RowMenuItem}">
      <Setter Property="Foreground" Value="{StaticResource Danger}"/>
      <Setter Property="Background" Value="#FCEDED"/>
    </Style>

    <!-- 输入框右键的剪切/复制/粘贴，以及其它没单独指定样式的菜单，一律沿用上面
         白底圆角面板的那一套，不再露出 WPF 默认的灰渐变方角菜单。宽度按内容自适应，
         以便容下右侧的快捷键提示。 -->
    <Style TargetType="ContextMenu" BasedOn="{StaticResource RowMenu}">
      <Setter Property="Width" Value="Auto"/>
      <Setter Property="MinWidth" Value="132"/>
    </Style>
    <Style TargetType="MenuItem" BasedOn="{StaticResource RowMenuItem}"/>

    <Style x:Key="PlainButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="MinHeight" Value="28"/>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,7"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>
    <!-- 词库底部的小加号：加一条新记录 -->
    <Style x:Key="AddButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <!-- ============ 输入框：浅灰底，聚焦时变白并出现绿色描边；Tag 当占位提示 ============ -->
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="{StaticResource Fill}"/>
      <Setter Property="Foreground" Value="{StaticResource Label}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="9"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <Grid>
                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="{TemplateBinding Padding}"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"/>
                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{StaticResource Tertiary}"
                           IsHitTestVisible="False" Visibility="Collapsed" VerticalAlignment="Center"
                           Margin="{TemplateBinding Padding}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value="">
                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource FillStrong}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Root" Property="Background" Value="White"/>
                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="PasswordBox">
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="{StaticResource Fill}"/>
      <Setter Property="Foreground" Value="{StaticResource Label}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="9"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="{TemplateBinding Padding}"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Root" Property="Background" Value="White"/>
                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 下拉框 ============ -->
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Foreground" Value="{StaticResource Label}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{StaticResource Fill}" CornerRadius="9" Padding="12,6">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Path x:Name="Arrow" Grid.Column="1" Data="M 0 0 L 4.5 4.5 L 9 0" Stroke="{StaticResource Secondary}"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource FillStrong}"/>
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Arrow" Property="RenderTransform">
                          <Setter.Value><RotateTransform Angle="180" CenterX="4.5" CenterY="2"/></Setter.Value>
                        </Setter>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="Label" Margin="13,0,32,0" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
              <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                     IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                     Placement="Bottom" VerticalOffset="6">
                <Border Background="White" CornerRadius="12" BorderBrush="{StaticResource Separator}" BorderThickness="1"
                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="300" Margin="0,0,0,20">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.14" Color="#000000"/>
                  </Border.Effect>
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter Margin="5"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.4"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Padding" Value="10,7"/>
      <!-- No dotted focus adorner: the rounded highlight already shows the selection. -->
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="{StaticResource Label}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Root" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"
                    Margin="0,1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource Fill}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoft}"/>
                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 开关：把 CheckBox 画成 iOS 开关 ============ -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Label}"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="ModelSelectionCard" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,4,0,4"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border x:Name="Card" Background="#F7F9F8" BorderBrush="#E0E7E3" BorderThickness="1" CornerRadius="11" Padding="14,12">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border x:Name="Check" Width="19" Height="19" CornerRadius="5" BorderBrush="#BAC7BF" BorderThickness="1" Background="White" VerticalAlignment="Center" Margin="0,0,12,0">
                <Path x:Name="Tick" Visibility="Collapsed" Data="M 2,6 L 5,9 L 11,2" Width="11" Height="9" Stretch="Uniform" Stroke="White" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
              <Border Grid.Column="2" Background="White" CornerRadius="6" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="Badge" Text="{TemplateBinding Tag}" FontSize="11" Foreground="{StaticResource Accent}"/>
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="付费"><Setter TargetName="Badge" Property="Foreground" Value="#9A681D"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#95B8A6"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Card" Property="Background" Value="#EDF7F1"/>
              <Setter TargetName="Card" Property="BorderBrush" Value="#9BCDB6"/>
              <Setter TargetName="Check" Property="Background" Value="{StaticResource Accent}"/>
              <Setter TargetName="Check" Property="BorderBrush" Value="{StaticResource Accent}"/>
              <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Card" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="local:SwitchMotion.Enabled" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Track" Width="46" Height="28" CornerRadius="14" Background="#D5DBD8">
              <Ellipse x:Name="Thumb" Width="24" Height="24" Fill="White" HorizontalAlignment="Left"
                       Margin="2,0,0,0">
                <Ellipse.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.25"/></Ellipse.Effect>
                <Ellipse.RenderTransform><TranslateTransform X="0"/></Ellipse.RenderTransform>
              </Ellipse>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="Thumb" Property="RenderTransform">
                  <Setter.Value><TranslateTransform X="18"/></Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Track" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 分段控件：灰色轨道里一个白色滑块 ============ -->
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Label}"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Root" Background="Transparent" CornerRadius="7" Padding="16,5" MinWidth="88">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Label}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Root" Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="{StaticResource Label}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter TargetName="Root" Property="Effect">
                  <Setter.Value><DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.16"/></Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 侧边栏导航项（图标取自系统自带的 Segoe MDL2 Assets，通过 Tag 传入） ============ -->
    <Style x:Key="NavItem" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Label}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Root" Background="Transparent" CornerRadius="9" Padding="10,8" Margin="0,0,0,2">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="Icon" Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="15"
                           Width="22" TextWrapping="NoWrap" Foreground="{StaticResource Secondary}"
                           VerticalAlignment="Center"/>
                <ContentPresenter VerticalAlignment="Center" Margin="6,0,0,0"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#0F000000"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Root" Property="Background" Value="White"/>
                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource Accent}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter TargetName="Root" Property="Effect">
                  <Setter.Value><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08"/></Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 滑块 ============ -->
    <Style x:Key="SliderFill" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Grid Background="Transparent" Height="28">
              <Border Height="4" CornerRadius="2,0,0,2" Background="{StaticResource Accent}" VerticalAlignment="Center"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SliderBlank" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent" Height="28"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SliderThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Ellipse Width="22" Height="22" Fill="White" Stroke="#DCE2DF" StrokeThickness="1">
              <Ellipse.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.18"/></Ellipse.Effect>
            </Ellipse>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Cursor" Value="Hand"/>
      <!-- The range is 0 to 1. The WPF defaults of 1 and 10 would send the
           value to one end of the track on every click on it. -->
      <Setter Property="SmallChange" Value="0.02"/>
      <Setter Property="LargeChange" Value="0.1"/>
      <!-- A click on the track puts the thumb where the pointer is. -->
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid MinHeight="28" Background="Transparent">
              <Border Height="4" CornerRadius="2" Background="#DCE2DF" VerticalAlignment="Center"/>
              <Track x:Name="PART_Track">
                <!-- The two repeat buttons only draw the track. They carry no
                     command, so a click on the track does not jump the value. -->
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource SliderFill}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource SliderThumb}"/></Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource SliderBlank}"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 细滚动条（只在列表内部出现） ============ -->
    <Style x:Key="ScrollBlank" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="#C9D1CD" CornerRadius="3" Margin="2,0"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollBlank}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollBlank}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 列表 ============ -->
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Root" Background="Transparent" CornerRadius="9" Padding="12,7" Margin="5,1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <!-- Hover uses FillStrong, not Fill: Fill is exactly the input field tint,
                   so a hovered row used to swallow the fields sitting on it. -->
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource FillStrong}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoft}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- 朗读记录：不显示选中态 -->
    <Style x:Key="LogItem" TargetType="ListBoxItem">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Root" Background="Transparent" CornerRadius="8" Padding="12,6" Margin="2,0">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource Fill}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
