<Window x:Class="VoiceBridge.App.AddItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加" Width="440" Height="Auto" MinHeight="260" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PageBg}"
        FontFamily="Microsoft YaHei UI" FontSize="14" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
  <Grid Margin="28,26,28,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="NameLabel" Style="{StaticResource FieldLabel}"/>
    <TextBox x:Name="NameBox" Grid.Row="1" Margin="0,0,0,16" MaxLength="64"/>
    <TextBlock x:Name="ValueLabel" Grid.Row="2" Style="{StaticResource FieldLabel}"/>
    <TextBox x:Name="ValueBox" Grid.Row="3" MaxLength="512"/>
    <PasswordBox x:Name="SecretBox" Grid.Row="3" MaxLength="1024" Visibility="Collapsed"/>
    <TextBlock x:Name="MessageText" Grid.Row="4" Style="{StaticResource Hint}" Foreground="{StaticResource Danger}"
               Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button Content="取消" Style="{StaticResource SecondaryButton}" MinWidth="80" Click="CancelClick" IsCancel="True"/>
      <Button x:Name="SaveButton" Content="保存" Style="{StaticResource PrimaryButton}" MinWidth="80" Margin="10,0,0,0"
              Click="SaveClick" IsDefault="True"/>
    </StackPanel>
  </Grid>
</Window>
