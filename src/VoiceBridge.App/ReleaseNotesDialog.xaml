<Window x:Class="VoiceBridge.App.ReleaseNotesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="更新说明" Width="544" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="#EEF2EF" FontFamily="Microsoft YaHei UI" FontSize="14"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="50" CornerRadius="14" GlassFrameThickness="1"
                        ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <!-- Overlay scrollbar: reveal on hover without changing the text width. -->
    <Style x:Key="NotesScrollViewer" TargetType="ScrollViewer">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollViewer">
            <Grid>
              <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      CanContentScroll="{TemplateBinding CanContentScroll}"
                                      Margin="{TemplateBinding Padding}"/>
              <ScrollBar x:Name="PART_VerticalScrollBar" Orientation="Vertical"
                         HorizontalAlignment="Right" Margin="0,10,2,10" Width="8" MinWidth="8"
                         Maximum="{TemplateBinding ScrollableHeight}"
                         ViewportSize="{TemplateBinding ViewportHeight}"
                         Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                         Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Opacity="0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger SourceName="PART_VerticalScrollBar" Property="IsMouseCaptureWithin" Value="True">
                <Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NotesCloseButton" TargetType="Button">
      <Setter Property="Width" Value="42"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Margin" Value="4,3,4,3"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="Transparent" CornerRadius="6">
              <Path x:Name="Glyph" Width="10" Height="10" Stretch="Uniform"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Data="M 1,1 L 9,9 M 9,1 L 1,9" Stroke="{StaticResource Secondary}"
                    StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#C42B1C"/>
                <Setter TargetName="Glyph" Property="Stroke" Value="White"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#A81E13"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <!-- Shadow only the surface, keeping the text itself crisp at each DPI. -->
    <Border x:Name="SurfaceShadow" Margin="12" Background="#FFFEFB" CornerRadius="14" IsHitTestVisible="False">
      <Border.Effect>
        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.18" Color="#263B2E"/>
      </Border.Effect>
    </Border>
    <Border x:Name="DialogSurface" Margin="12" Background="#FFFEFB" BorderBrush="#CAD4CD"
            BorderThickness="1" CornerRadius="14">
    <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="36"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid x:Name="CaptionBar" Background="Transparent">
      <Button x:Name="CloseNotesButton" Style="{StaticResource NotesCloseButton}"
              HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True"
              AutomationProperties.Name="关闭更新说明" ToolTip="关闭" Click="DismissClick"/>
    </Grid>
    <Grid Grid.Row="1" Margin="28,8,28,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,18">
        <TextBlock x:Name="VersionTitle" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="看看这次有哪些变化" Style="{StaticResource Subtitle}" Margin="0,6,0,0"/>
      </StackPanel>
      <Border Grid.Row="1" Background="White" BorderBrush="#E4E9E5" BorderThickness="1" CornerRadius="12">
        <Grid>
        <ScrollViewer x:Name="NotesScroller" MaxHeight="340" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Style="{StaticResource NotesScrollViewer}"
                      Padding="16,14,22,18" CanContentScroll="False" Focusable="True">
          <StackPanel>
            <TextBlock x:Name="ReleaseHeading" Text="本次更新" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <ItemsControl x:Name="NotesItems">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="•" Foreground="{StaticResource Accent}"/>
                    <TextBlock Grid.Column="1" Text="{Binding}" LineHeight="23" TextWrapping="Wrap"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="完整版本记录可在「使用说明 → 更新日志」查看。" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
          </StackPanel>
        </ScrollViewer>
        <!-- Fixed viewport frame; only unfinished content fades at the edges. -->
        <Border x:Name="NotesTopFade" Height="20" VerticalAlignment="Top" Margin="1,1,12,0"
                IsHitTestVisible="False" Visibility="Collapsed">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#FFFFFFFF" Offset="0"/>
              <GradientStop Color="#00FFFFFF" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <Border x:Name="NotesBottomFade" Height="30" VerticalAlignment="Bottom" Margin="1,0,12,1"
                IsHitTestVisible="False" Visibility="Collapsed">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#00FFFFFF" Offset="0"/>
              <GradientStop Color="#FFFFFFFF" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        </Grid>
      </Border>
      <Button Grid.Row="2" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,20,0,0"
              IsDefault="True" IsCancel="True" Click="DismissClick">
        <TextBlock Text="知道了" Foreground="White" TextWrapping="NoWrap"/>
      </Button>
    </Grid>
    </Grid>
    </Border>
  </Grid>
</Window>
